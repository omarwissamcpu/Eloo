# Required in production: a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
PORT=4000
DB_PATH=./eloo.db

# Routing and search engines. The defaults are free public demo servers:
# fine for development, NOT for launch. Self-host OSRM and Photon with the Iraq map.
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io

# Phone sign-up codes. "console" prints codes in the server log (development).
# Set to "twilio" (or add another provider in src/auth.js) for real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
