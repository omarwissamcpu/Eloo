PORT=4000

# Database. Free option: a Turso database (turso.tech) → libsql://<name>.turso.io + its auth token.
# Leave empty to use a local file (development only; containers lose it on redeploy).
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Optional. If empty in production, the server creates one on first start and keeps it in the database.
JWT_SECRET=

# Routing and search engines. The defaults are free public demo servers:
# fine for development, NOT for launch. Self-host OSRM and Photon with the Iraq map.
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io

# Phone sign-up codes. "console" prints codes in the server log (development).
# Set to "twilio" (or add another provider in src/auth.js) for real SMS.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
